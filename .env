APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=16&charset=utf8"

# Manticore
MANTICORE_URL="http://manticore:9308"

# Docker ports
NGINX_PORT=8080
PHP_FPM_PORT=9000
POSTGRES_PORT=5432
MANTICORE_HTTP_PORT=9308
MANTICORE_SPHINX_PORT=9306

# Docker postgres
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Routing
DEFAULT_URI=http://localhost
